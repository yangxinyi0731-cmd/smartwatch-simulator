        "site_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Site Id",
          "type": "string"
        },
        "synchronization_error_ms": {
          "minimum": 0,
          "title": "Synchronization Error Ms",
          "type": "number"
        },
        "t_impact_ns": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "T Impact Ns"
        },
        "t_instability_ns": {
          "exclusiveMinimum": 0,
          "title": "T Instability Ns",
          "type": "integer"
        },
        "t_recovery_or_assist_ns": {
